---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import AsciiStorm from "../components/AsciiStorm.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import CopyrightFooter from "../components/CopyrightFooter.astro";
import { useTranslations } from "../i18n/utils";
import { getLocalizedTagMaps } from "../lib/tag-i18n";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const locale = Astro.currentLocale ?? "en";
const t = useTranslations(locale);

const { tooltipMap: tooltipsMap } = await getLocalizedTagMaps(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead title={title} description={description} />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-tui-bg font-mono text-tui-text antialiased">
    <LoadingScreen />
    <AsciiStorm />
    <Navbar />
    <div class="pt-20">
      <slot />
    </div>
    <CopyrightFooter />
    <script
      type="application/json"
      id="tooltip-data"
      set:html={JSON.stringify({ tooltips: tooltipsMap, noTooltipText: t('tooltip.unavailable') })}
    />
  </body>
</html>

<script>
  import { initLocaleRedirect } from "../lib/client/locale-redirect";
  import { initExternalLinkMarking } from "../lib/client/external-links";
  import { initPageTransitions } from "../lib/client/page-transitions";
  import { initCarouselPaging } from "../lib/client/carousel";
  import { initTagEasterEgg } from "../lib/client/tag-easter-egg";
  import { initHoverTooltip } from "../lib/client/hover-tooltip";

  initLocaleRedirect();
  initExternalLinkMarking();
  initPageTransitions();
  initCarouselPaging();
  initTagEasterEgg();
  initHoverTooltip();
</script>
