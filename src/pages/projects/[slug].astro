---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../../layouts/Layout.astro";
import TerminalPanel from "../../components/TerminalPanel.astro";
import Button from "../../components/Button.astro";
import ProjectTag from "../../components/ProjectTag.astro";
import LucideIcon from "../../components/LucideIcon.astro";
import ProjectCoverPlaceholder from "../../components/ProjectCoverPlaceholder.astro";
import { fetchGithubStars, formatStarCount } from "../../lib/github-stars";
import { useTranslations } from "../../i18n/utils";
import { renderLocalizedProject } from "../../lib/i18n-content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const locale = Astro.currentLocale ?? "en";
const t = useTranslations(locale);

const { data: projectData, Content } = await renderLocalizedProject(project, locale);
const {
  title,
  summary,
  stack,
  cover,
  coverGif,
  icon,
  gallery,
  youtubeId,
  audio,
  repo,
  external,
  private: isPrivate,
  displayStars,
  startYear,
  endYear,
} = projectData;

const stars = displayStars && repo ? await fetchGithubStars(repo) : null;
---

<Layout title={`${t("meta.home.title")}: ${title}`} description={summary}>
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-8">
    <a
      href={getRelativeLocaleUrl(locale, "/projects")}
      class="mb-4 inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-tui-muted transition-colors hover:text-tui-gold"
    >
      <LucideIcon name="chevron-left" class="h-4 w-4" />
      {t("projects.back")}
    </a>
    <TerminalPanel
      label={isPrivate ? t("project.private") : t("project.public")}
      labelColor={isPrivate ? "red" : "green"}
      bodyClass="space-y-8"
    >
      {
        coverGif ? (
          <img src={coverGif} alt="" class="w-full border border-tui-border" />
        ) : cover ? (
          <Image src={cover} alt="" class="w-full border border-tui-border" />
        ) : (
          <ProjectCoverPlaceholder title={title} class="w-full border border-tui-border" />
        )
      }

      <header class="space-y-3">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-3">
            {icon && <img src={icon} alt="" class="h-8 w-8 shrink-0 object-contain" />}
            <h1 class="text-3xl font-bold text-tui-text">{title}</h1>
          </div>
          {
            stars != null && (
              <span class="flex shrink-0 items-center gap-1 pt-1 text-sm font-semibold text-tui-gold">
                <LucideIcon name="star" class="h-4 w-4 fill-current" />
                {formatStarCount(stars)}
              </span>
            )
          }
        </div>
        <p class="text-tui-muted">{summary}</p>
        <ul class="flex flex-wrap gap-2">
          {stack.map((tech) => <ProjectTag tech={tech} />)}
        </ul>
        <p class="text-xs text-tui-muted">
          {startYear}-{endYear ?? t("project.now")}
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          {repo && <Button href={repo}>{t("project.link")}</Button>}
          {external && <Button href={external}>{t("project.live")}</Button>}
        </div>
      </header>

      {
        youtubeId && (
          <div class="aspect-video w-full overflow-hidden border border-tui-border">
            <iframe
              class="h-full w-full"
              src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
              title={`${title} demo video`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        )
      }

      {
        gallery.length > 0 && (
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {gallery.map((img) => (
              <Image
                src={img}
                alt=""
                class="aspect-video w-full border border-tui-border object-cover"
              />
            ))}
          </div>
        )
      }

      {
        audio && (
          <audio controls class="w-full">
            <source src={audio} />
          </audio>
        )
      }

      <div
        class="prose prose-invert max-w-none prose-headings:font-mono prose-headings:uppercase prose-headings:tracking-wide prose-headings:text-tui-gold prose-p:text-tui-text prose-a:text-tui-cyan prose-strong:text-tui-cyan prose-code:text-tui-green"
      >
        <Content />
      </div>
    </TerminalPanel>
  </main>
</Layout>
