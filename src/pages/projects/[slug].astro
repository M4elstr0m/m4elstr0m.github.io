---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TerminalPanel from '../../components/TerminalPanel.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { findIcon } from '../../lib/find-icon';
import { categorizeTag, tagColorClasses } from '../../lib/categorize-tag';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  summary,
  stack,
  cover,
  gallery,
  youtubeId,
  audio,
  repo,
  external,
  private: isPrivate,
} = project.data;
const { Content } = await render(project);

const about = await getEntry('pages', 'about');
const categories = {
  interests: about?.data.interests ?? [],
  stack: about?.data.stack ?? [],
  tools: about?.data.tools ?? [],
};
---

<Layout title={`M4elstr0m: ${title}`} description={summary}>
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-8">
    <TerminalPanel
      label={isPrivate ? 'private' : 'public'}
      labelColor={isPrivate ? 'red' : 'green'}
      bodyClass="space-y-8"
    >
      <Image src={cover} alt="" class="w-full border border-tui-border" />

      <header class="space-y-3">
        <h1 class="text-3xl font-bold text-tui-text">{title}</h1>
        <p class="text-tui-muted">{summary}</p>
        <ul class="flex flex-wrap gap-2">
          {
            stack.map((tech) => (
              <li
                class:list={[
                  'flex items-center gap-1.5 border border-tui-border px-2 py-0.5 text-xs uppercase tracking-wider transition-all duration-200 hover:-translate-y-0.5',
                  tagColorClasses[categorizeTag(tech, categories)],
                ]}
              >
                {findIcon(tech) && <Icon icon={findIcon(tech)!} class="h-3 w-3 shrink-0" />}
                {tech}
              </li>
            ))
          }
        </ul>
        <div class="flex flex-wrap gap-3 pt-2">
          {repo && <Button href={repo}>source</Button>}
          {external && <Button href={external}>live</Button>}
        </div>
      </header>

      {
        youtubeId && (
          <div class="aspect-video w-full overflow-hidden border border-tui-border">
            <iframe
              class="h-full w-full"
              src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
              title={`${title} demo video`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        )
      }

      {
        gallery.length > 0 && (
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {gallery.map((img) => (
              <Image src={img} alt="" class="aspect-video w-full border border-tui-border object-cover" />
            ))}
          </div>
        )
      }

      {
        audio && (
          <audio controls class="w-full">
            <source src={audio} />
          </audio>
        )
      }

      <div class="prose prose-invert max-w-none prose-headings:font-mono prose-headings:uppercase prose-headings:tracking-wide prose-headings:text-tui-gold prose-p:text-tui-text prose-a:text-tui-cyan prose-strong:text-tui-cyan prose-code:text-tui-green">
        <Content />
      </div>
    </TerminalPanel>
  </main>
</Layout>
