---
import { slide } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import ProjectsPreviewSection from "../components/sections/ProjectsPreviewSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import ScrollHint from "../components/ScrollHint.astro";
import SwipeHint from "../components/SwipeHint.astro";
import { useTranslations } from "../i18n/utils";

const locale = Astro.currentLocale ?? "en";
const t = useTranslations(locale);
---

<Layout
  title={t("meta.home.title")}
  description={t("meta.home.description")}
>
  <main>
    <section
      id="about"
      class="relative flex min-h-[calc(100vh-5rem)] snap-start scroll-mt-20 items-start px-4 pb-16 pt-8 sm:px-8"
    >
      <div class="relative w-full">
        <div
          class="w-full"
          transition:name="about-page"
          transition:animate={slide({ duration: "0.4s" })}
        >
          <AboutSection />
        </div>
        <SwipeHint target={getRelativeLocaleUrl(locale, "/about")} />
      </div>
      <ScrollHint target="#projects" />
    </section>
    <section
      id="projects"
      class="relative flex min-h-[calc(100vh-5rem)] snap-start scroll-mt-20 items-stretch"
    >
      <div
        class="flex w-full items-center px-4 py-12 sm:px-8"
        transition:name="projects-page"
        transition:animate={slide({ duration: "0.4s" })}
      >
        <div class="relative w-full">
          <ProjectsPreviewSection />
          <SwipeHint target={getRelativeLocaleUrl(locale, "/projects")} />
        </div>
      </div>
      <ScrollHint target="#contact" />
    </section>
    <section
      id="contact"
      class="relative flex min-h-[calc(100vh-5rem)] snap-start scroll-mt-20 items-center px-4 py-12 sm:px-8"
    >
      <ContactSection />
    </section>
  </main>
</Layout>
