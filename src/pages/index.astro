---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="M4elstr0m: Work in Progress"
  description="Portfolio of M4elstr0m, a cybersecurity, OSINT, and software developer working primarily in Go and Rust. Currently under construction."
>
  <main class="flex min-h-screen flex-col items-center justify-center gap-4 px-4 text-center">
    <p class="flex items-center gap-2 text-sm text-emerald-400">
      <span class="inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
      HTTP/1.1 200 OK
    </p>
    <h1 class="text-3xl font-semibold tracking-tight text-slate-100 sm:text-4xl">
      Work in Progress
    </h1>
    <p class="max-w-md text-sm text-slate-400">
      This site is being built. Check back soon.
    </p>
  </main>
</Layout>
