---
import { siGithub } from 'simple-icons';
import TerminalPanel from '../TerminalPanel.astro';
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import { useTranslations } from '../../i18n/utils';
import { renderLocalizedPage } from '../../lib/i18n-content';

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);
const { data: contactData, Content } = await renderLocalizedPage('contact', locale);
const { heading, github } = contactData;
---

<TerminalPanel
  label={t('panel.contact')}
  class="w-full min-h-[42vh]"
  bodyClass="flex flex-col items-center justify-center gap-6 text-center"
>
  <h2 class="text-[clamp(1.5rem,4vh,2.25rem)] font-bold tracking-tight text-tui-gold">{heading}</h2>
  <div class="prose prose-invert max-w-md text-base prose-p:text-tui-muted sm:text-lg">
    <Content />
  </div>
  {
    github && (
      <Button href={github}>
        <Icon icon={siGithub} class="h-5 w-5" />
        github.com/M4elstr0m
      </Button>
    )
  }
</TerminalPanel>
