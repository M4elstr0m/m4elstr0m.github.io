---
import { getCollection } from 'astro:content';
import TerminalPanel from '../TerminalPanel.astro';
import ProjectCard from '../ProjectCard.astro';
import SeeMoreCard from '../SeeMoreCard.astro';
import Button from '../Button.astro';
import { sortProjectsByRank } from '../../lib/sort-projects';

const featured = (await getCollection('projects')).filter((project) => project.data.featured);
const projects = (await sortProjectsByRank(featured)).slice(0, 3);
---

<TerminalPanel label="projects" class="w-full">
  <div class="grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {projects.map((project) => <ProjectCard project={project} />)}
    <SeeMoreCard />
  </div>
  <div class="mt-10 flex justify-center">
    <Button href="/projects">view all projects</Button>
  </div>
</TerminalPanel>
