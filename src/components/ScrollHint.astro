---
import LucideIcon from './LucideIcon.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  target: string;
}

const { target } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<a
  href={target}
  class="absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 animate-bounce flex-col items-center gap-1 p-3 text-[10px] uppercase tracking-[0.3em] text-tui-muted transition-colors hover:text-tui-gold"
>
  <span>-- {t('hint.more')} --</span>
  <LucideIcon name="chevron-down" class="h-4 w-4" />
</a>
