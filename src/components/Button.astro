---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2 border border-tui-gold bg-tui-gold px-6 py-2.5 text-sm font-bold uppercase tracking-widest text-tui-panel transition-colors hover:bg-transparent hover:text-tui-gold',
    className,
  ]}
>
  <slot />
</a>
