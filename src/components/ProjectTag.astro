---
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import { findIcon } from '../lib/find-icon';
import { getTagColor, tagColorClasses } from '../lib/categorize-tag';
import { getLocalizedTagMaps, getTagLabel } from '../lib/tag-i18n';

interface Props {
  tech: string;
}

const { tech } = Astro.props;
const icon = findIcon(tech);

const tagsEntry = await getEntry('taxonomy', 'tags');
const colorMap = Object.fromEntries(
  (tagsEntry?.data.tags ?? []).map((t) => [t.tag.toLowerCase(), t.color]),
);

const { labelMap } = await getLocalizedTagMaps(Astro.currentLocale ?? 'en');
---

<li
  data-tag={tech.toLowerCase()}
  class:list={[
    'flex items-center gap-1.5 border border-tui-border px-2 py-0.5 text-xs uppercase tracking-wider transition-all duration-200 hover:-translate-y-0.5',
    tagColorClasses[getTagColor(tech, colorMap)],
  ]}
>
  {icon && <Icon icon={icon} class="h-3 w-3 shrink-0" />}
  {getTagLabel(tech, labelMap)}
</li>
