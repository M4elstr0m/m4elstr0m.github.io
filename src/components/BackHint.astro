---
import LucideIcon from './LucideIcon.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  target: string;
  label?: string;
}

const { target, label } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const displayLabel = label ?? t('hint.home');
---

<a
  href={target}
  data-back-hint
  class="fixed inset-y-0 left-4 z-10 hidden flex-col items-center justify-center gap-1 text-tui-muted transition-colors hover:text-tui-gold sm:flex"
>
  <LucideIcon name="chevron-left" class="h-8 w-8 animate-pulse" />
  <span class="text-[10px] uppercase tracking-[0.2em]">{displayLabel}</span>
</a>

<script>
  import { navigate } from 'astro:transitions/client';

  const NAVBAR_OFFSET = 80;
  const HOP_DURATION = 200;

  function animatedScrollTo(targetY: number, duration: number): Promise<void> {
    return new Promise((resolve) => {
      const startY = window.scrollY;
      const delta = targetY - startY;
      if (Math.abs(delta) < 1) {
        resolve();
        return;
      }
      const start = performance.now();
      function step(now: number) {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        window.scrollTo({ top: startY + delta * eased, left: 0, behavior: 'instant' });
        if (t < 1) {
          requestAnimationFrame(step);
        } else {
          resolve();
        }
      }
      requestAnimationFrame(step);
    });
  }

  function bindBackHints() {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-back-hint]')) {
      if (link.dataset.bound) continue;
      link.dataset.bound = 'true';

      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href');
        if (!href) return;

        const firstSection = document.querySelector<HTMLElement>('main .snap-start');
        if (!firstSection) return;

        const isAligned = Math.abs(firstSection.getBoundingClientRect().top - NAVBAR_OFFSET) < 10;
        if (isAligned) return;

        event.preventDefault();

        document.documentElement.dataset.multiHop = 'true';
        const targetY = window.scrollY + firstSection.getBoundingClientRect().top - NAVBAR_OFFSET;
        const previousSnapType = document.documentElement.style.scrollSnapType;
        document.documentElement.style.scrollSnapType = 'none';
        animatedScrollTo(targetY, HOP_DURATION).then(() => {
          document.documentElement.style.scrollSnapType = previousSnapType;
          navigate(href);
        });
      });
    }
  }

  bindBackHints();
  document.addEventListener('astro:page-load', bindBackHints);
</script>
