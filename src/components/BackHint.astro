---
import LucideIcon from './LucideIcon.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  target: string;
  label?: string;
}

const { target, label } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const displayLabel = label ?? t('hint.home');
---

<a
  href={target}
  data-back-hint
  class="fixed left-4 top-1/2 z-10 hidden -translate-y-1/2 flex-col items-center justify-center gap-1 p-3 text-tui-muted transition-colors hover:text-tui-gold sm:flex"
>
  <LucideIcon name="chevron-left" class="h-8 w-8 animate-pulse" />
  <span class="text-[10px] uppercase tracking-[0.2em]">{displayLabel}</span>
</a>

<script>
  import { navigate } from 'astro:transitions/client';
  import { NAVBAR_OFFSET, animatedScrollTo } from '../lib/client/scroll';

  const HOP_DURATION = 200;

  function bindBackHints() {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-back-hint]')) {
      if (link.dataset.bound) continue;
      link.dataset.bound = 'true';

      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href');
        if (!href) return;

        const firstSection = document.querySelector<HTMLElement>('main .snap-start');
        if (!firstSection) return;

        const isAligned = Math.abs(firstSection.getBoundingClientRect().top - NAVBAR_OFFSET) < 10;
        if (isAligned) return;

        event.preventDefault();

        document.documentElement.dataset.multiHop = 'true';
        const targetY = window.scrollY + firstSection.getBoundingClientRect().top - NAVBAR_OFFSET;
        const previousSnapType = document.documentElement.style.scrollSnapType;
        document.documentElement.style.scrollSnapType = 'none';
        animatedScrollTo(targetY, HOP_DURATION).then(() => {
          document.documentElement.style.scrollSnapType = previousSnapType;
          navigate(href);
        });
      });
    }
  }

  bindBackHints();
  document.addEventListener('astro:page-load', bindBackHints);
</script>
