---
const currentYear = new Date().getFullYear();
---

<footer
  class="fixed bottom-3 right-4 z-30 hidden text-[10px] uppercase tracking-[0.15em] text-tui-muted sm:block"
>
  &copy; <span id="copyright-year">{currentYear}</span> <a href="https://github.com/M4elstr0m" data-no-external-icon class="hover:text-tui-gold transition-colors">M4elstr0m</a>
</footer>

<script>
  function updateCopyrightYear() {
    const el = document.getElementById('copyright-year');
    if (el) el.textContent = String(new Date().getFullYear());
  }

  updateCopyrightYear();
  document.addEventListener('astro:page-load', updateCopyrightYear);
</script>
