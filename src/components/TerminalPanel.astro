---
interface Props {
  label: string;
  labelColor?: 'gold' | 'cyan' | 'orange' | 'green' | 'red';
  class?: string;
  bodyClass?: string;
}

const { label, labelColor = 'gold', class: className, bodyClass } = Astro.props;

const labelColorClass = {
  gold: 'text-tui-gold',
  cyan: 'text-tui-cyan',
  orange: 'text-tui-orange',
  green: 'text-tui-green',
  red: 'text-tui-red',
}[labelColor];
---

<div class:list={['flex flex-col border border-tui-border bg-tui-panel', className]}>
  <div class="flex items-center gap-2 border-b border-tui-border bg-tui-border/20 px-4 py-2">
    <span class="text-tui-green">$</span>
    <span class:list={['text-xs font-bold uppercase tracking-[0.25em]', labelColorClass]}>{label}</span>
  </div>
  <div class:list={['flex-1 p-6 sm:p-8', bodyClass]}>
    <slot />
  </div>
</div>
